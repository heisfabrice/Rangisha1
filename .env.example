# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# MongoDB Atlas connection URI (Optional: seamlessly falls back to local high-speed persistent store if not set)
MONGODB_URI="mongodb+srv://<username>:<password>@cluster0.mongodb.net/ranga?retryWrites=true&w=majority"

# Admin Emergency Credential (for initial bootstrap)
ADMIN_EMAIL="admin@ranga.rw"
ADMIN_PASSWORD="ranga_admin_2026"

# Notification & Email (Transactional Email abstraction)
EMAIL_SERVER="smtp.postmarkapp.com"
EMAIL_PORT="587"
EMAIL_USERNAME="api-key"
EMAIL_PASSWORD="password"
EMAIL_FROM="noreply@ranga.rw"

# WhatsApp Business API / Dynamic Link Config
WHATSAPP_NUMBER="250788123456"

# Cloudinary / Storage abstraction
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

