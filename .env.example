# ==============================================================================
# Rangisha.com - Environment Variables Configuration
# ==============================================================================
# In Vercel, set these in: Project Settings -> Environment Variables
# Target Environments: Production, Preview, Development
# ==============================================================================

# MongoDB Atlas Connection URI (Required for Production Database Persistence)
# Example: mongodb+srv://db_user:YOUR_SECURE_PASSWORD@cluster0.mongodb.net/rangisha?retryWrites=true&w=majority
MONGODB_URI="mongodb+srv://<username>:<password>@cluster0.mongodb.net/rangisha?retryWrites=true&w=majority"
MONGODB_DB_NAME="rangisha"

# Admin Authentication Credentials (Required for Admin Portal Login)
# Set your secure administrator password and email in Vercel settings
ADMIN_EMAIL="admin@ranga.rw"
ADMIN_PASSWORD="YOUR_SECURE_ADMIN_PASSWORD"
ADMIN_NAME="Rangisha Administrator"

# Secret Key for Signing Admin JWT Session Tokens (HMAC-SHA256)
# Generate a random 32+ character string for production
JWT_SECRET="YOUR_RANDOM_SECURE_32_CHAR_JWT_SECRET_STRING"

# Application Environment
NODE_ENV="production"
PORT=3000
